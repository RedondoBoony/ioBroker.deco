{
    "type": "panel",
    "i18n": true,
    "items": {
        "ip": {
            "type": "text",
            "label": "Router IP address",
            "help": "IP address of your Deco router (usually 192.168.68.1)",
            "placeholder": "192.168.68.1",
            "sm": 12,
            "md": 6,
            "validator": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}$",
            "validatorErrorText": "Enter a valid IPv4 address"
        },
        "password": {
            "type": "password",
            "label": "Router admin password",
            "help": "The same password you use to log in to the Deco app or web UI",
            "sm": 12,
            "md": 6
        },
        "_sep1": {
            "type": "divider"
        },
        "interval": {
            "type": "select",
            "label": "Poll interval",
            "help": "How often the adapter reads client data from the router",
            "sm": 12,
            "md": 6,
            "options": [
                {"value": 2,  "label": "2 seconds"},
                {"value": 5,  "label": "5 seconds"},
                {"value": 10, "label": "10 seconds"},
                {"value": 30, "label": "30 seconds"},
                {"value": 60, "label": "60 seconds"}
            ],
            "default": 5
        },
        "keepDisconnected": {
            "type": "checkbox",
            "label": "Keep disconnected clients",
            "help": "When enabled, clients that have left the network remain visible with connected = false",
            "sm": 12,
            "md": 6,
            "default": true
        }
    }
}
