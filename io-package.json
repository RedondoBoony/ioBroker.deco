      "0.7.0": {
        "en": "Add info.total_download_speed and info.total_upload_speed (sum of all clients)"
      },
      "0.6.0": {
        "en": "Clients stored by IP address; delete on IP change; configurable poll interval (2/5/10/30/60 s)"
      },
      "0.5.0": {
        "en": "Fix login: avoid double-navigation, use resilient button selector; wait for MAC data before scraping"
      },
      "0.4.0": {
        "en": "Fix client scraping: robust multi-strategy selector works on all Chromium viewport sizes"
      },
      "0.3.0": {
        "en": "Fix login: navigate directly to SPA URL, use networkidle2, skip meta-refresh redirect"
      },
      "0.2.0": {
        "en": "Switch to puppeteer-core with system Chromium auto-detection and auto-install"
      },
      "0.1.0": {
        "en": "Initial release"
      }
